{
  "welcomeFile": "/launchpadPage.html",
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/service/schoolmanagement/(.*)$",
      "target": "/service/schoolmanagement/$1",
      "destination": "schoolmanagement-srv-api",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^(.*)$",
      "target": "$1",
      "service": "html5-apps-repo-rt",
      "authenticationType": "xsuaa"
    }
  ]
}